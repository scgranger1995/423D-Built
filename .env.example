# ============================================
# 423D Built - Environment Variables
# Copy this file to .env.local and fill in values
# ============================================

# ---- Database ----
# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:password@localhost:5432/fourtwentythree_d_built?schema=public"

# ---- NextAuth.js ----
# Generate a secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# The canonical URL of your site
NEXTAUTH_URL="http://localhost:3000"

# ---- Square Payments ----
# Square access token (find at https://developer.squareup.com/apps)
SQUARE_ACCESS_TOKEN="EAAAl..."
# "sandbox" for testing, "production" for live
SQUARE_ENVIRONMENT="sandbox"
# Square location ID (find at https://developer.squareup.com/apps → Locations)
SQUARE_LOCATION_ID="L..."
# Webhook signature key (find at https://developer.squareup.com/apps → Webhooks)
SQUARE_WEBHOOK_SIGNATURE_KEY="whk_..."
# Full URL of the Square webhook endpoint (used for signature verification)
SQUARE_WEBHOOK_URL="https://yourdomain.com/api/webhooks/square"
# Square application ID (used client-side for the Web Payments SDK)
SQUARE_APPLICATION_ID="sandbox-sq0idb-..."
# Exposed to the browser for the Square Web Payments SDK
NEXT_PUBLIC_SQUARE_APPLICATION_ID="sandbox-sq0idb-..."

# ---- Shippo (Shipping) ----
# Shippo API token (find at https://app.goshippo.com/settings/api)
SHIPPO_API_TOKEN="shippo_test_..."

# ---- Ship From Address (your business address) ----
SHIP_FROM_NAME="423D Built"
SHIP_FROM_STREET="Bristol"
SHIP_FROM_CITY="Bristol"
SHIP_FROM_STATE="TN"
SHIP_FROM_ZIP="37620"
SHIP_FROM_COUNTRY="US"
SHIP_FROM_PHONE=""
SHIP_FROM_EMAIL=""

# ---- File Uploads ----
# Directory for uploaded files (relative to project root)
UPLOAD_DIR="./uploads"
# Maximum file size in bytes (default: 10MB)
MAX_FILE_SIZE="10485760"

# ---- App Configuration ----
# Base URL of the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Company name displayed in the UI
NEXT_PUBLIC_COMPANY_NAME="423D Built"
# Contact email
NEXT_PUBLIC_CONTACT_EMAIL=""
# Contact phone
NEXT_PUBLIC_CONTACT_PHONE=""

# ---- Optional: Email (for order notifications) ----
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASSWORD=""
# EMAIL_FROM="noreply@423dbuilt.com"

# ---- Docker / Production ----
# NODE_ENV="production"
# PORT=3000
