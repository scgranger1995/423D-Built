# ============================================
# 423D Built - Git Ignore
# ============================================

# --- Dependencies ---
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# --- Next.js ---
/.next/
/out/

# --- Production Build ---
/build
/.vercel
/standalone

# --- Testing ---
/coverage

# --- Environment Variables ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production
!.env.example

# --- Debug Logs ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- IDE / Editor ---
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# --- Prisma ---
prisma/migrations/migration_lock.toml
*.db
*.db-journal

# --- File Uploads ---
uploads/*
!uploads/.gitkeep

# --- OS Files ---
Thumbs.db
ehthumbs.db
Desktop.ini

# --- Misc ---
*.pem
*.log
.vercel
