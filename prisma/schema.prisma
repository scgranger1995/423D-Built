// ============================================
// 423D Built - Prisma Schema
// PostgreSQL via Neon
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// Models (SQLite doesn't support enums, using String)
// ============================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String   @map("password_hash")
  role         String   @default("EDITOR") // ADMIN | EDITOR
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Product {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  shortDescription    String?  @map("short_description")
  category            String   @default("OTHER") // PRINTING_3D | LASER_ENGRAVE | DESIGN | OTHER
  price               Int      // Price in cents
  compareAtPrice      Int?     @map("compare_at_price")
  material            String?
  color               String?
  dimensions          String?
  weight              Float?
  images              String   @default("[]") // JSON array of image URLs
  featured            Boolean  @default(false)
  active              Boolean  @default(true)
  inventory           Int      @default(0)
  madeToOrder         Boolean  @default(false) @map("made_to_order")
  customizable        Boolean  @default(false)
  customizationPrompt String?  @map("customization_prompt")
  squareVariationId   String?  @map("square_variation_id")
  squareCatalogId     String?  @map("square_catalog_id")
  tags                String   @default("[]") // JSON array of tags
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  orderItems OrderItem[]

  @@index([category])
  @@index([active])
  @@map("products")
}

model Order {
  id                    String   @id @default(cuid())
  orderNumber           String   @unique @map("order_number")
  customerEmail         String   @map("customer_email")
  customerName          String   @map("customer_name")
  customerPhone         String?  @map("customer_phone")
  shippingAddress       String   @map("shipping_address") // JSON
  billingAddress        String?  @map("billing_address") // JSON
  items                 OrderItem[]
  subtotal              Int
  shippingCost          Int      @default(0) @map("shipping_cost")
  taxAmount             Int      @default(0) @map("tax_amount")
  total                 Int
  status                String   @default("PENDING") // PENDING | PAID | PROCESSING | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentStatus         String   @default("PENDING") @map("payment_status") // PENDING | PAID | REFUNDED
  squareOrderId         String?  @unique @map("square_order_id")
  squarePaymentId       String?  @unique @map("square_payment_id")
  trackingNumber        String?  @map("tracking_number")
  trackingCarrier       String?  @map("tracking_carrier")
  shippoTransactionId   String?  @map("shippo_transaction_id")
  labelUrl              String?  @map("label_url")
  notes                 String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@index([customerEmail])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?  @map("product_id")
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName   String   @map("product_name")
  quantity      Int
  unitPrice     Int      @map("unit_price")
  customization String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([orderId])
  @@map("order_items")
}

model ServiceInquiry {
  id             String   @id @default(cuid())
  customerName   String   @map("customer_name")
  customerEmail  String   @map("customer_email")
  customerPhone  String?  @map("customer_phone")
  company        String?
  serviceType    String   @map("service_type") // PRINTING_3D | LASER_ENGRAVING | DESIGN | CONSULTATION
  description    String
  material       String?
  color          String?
  quantity       Int      @default(1)
  fileUrls       String   @default("[]") @map("file_urls") // JSON array
  timeline       String   @default("STANDARD") // STANDARD | RUSH | FLEXIBLE
  budget         String?
  referralSource String?  @map("referral_source")
  status         String   @default("NEW") // NEW | REVIEWED | QUOTED | ACCEPTED | IN_PROGRESS | COMPLETED | CANCELLED
  quotedPrice    Int?     @map("quoted_price")
  adminNotes     String?  @map("admin_notes")
  adminResponse  String?  @map("admin_response")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("service_inquiries")
}

model SiteContent {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  type      String   @default("TEXT") // TEXT | HTML | IMAGE | JSON
  section   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([section])
  @@map("site_content")
}

model ShippingSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("shipping_settings")
}

model Page {
  id          String      @id @default(cuid())
  title       String
  slug        String      @unique
  description String?
  published   Boolean     @default(false)
  isSystem    Boolean     @default(false) @map("is_system")
  sortOrder   Int         @default(0) @map("sort_order")
  blocks      PageBlock[]
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@map("pages")
}

model PageBlock {
  id        String   @id @default(cuid())
  pageId    String   @map("page_id")
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  type      String   // hero | text | image | gallery | cards | cta | contact_form | product_grid | faq | testimonials | custom_html | stats
  content   String   @default("{}") // JSON object with block-specific content
  settings  String   @default("{}") // JSON object with display settings (background, padding, etc.)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([pageId])
  @@map("page_blocks")
}

// ============================================
// Screen Print Quoting System
// ============================================

model Customer {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  company   String?
  address   String?  // JSON
  notes     String?
  taxExempt Boolean  @default(false) @map("tax_exempt")
  quotes    Quote[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("customers")
}

model Quote {
  id             String          @id @default(cuid())
  quoteNumber    String          @unique @map("quote_number")
  customerId     String?         @map("customer_id")
  customer       Customer?       @relation(fields: [customerId], references: [id])
  customerName   String          @default("") @map("customer_name")
  customerEmail  String?         @map("customer_email")
  customerPhone  String?         @map("customer_phone")
  status         String          @default("DRAFT") // DRAFT | SENT | APPROVED | IN_PRODUCTION | COMPLETED | INVOICED | PAID | CANCELLED
  jobType        String          @default("SCREEN_PRINT") @map("job_type") // SCREEN_PRINT | EMBROIDERY | STICKER | PATCH | HAT | MIXED
  title          String?
  dueDate        DateTime?       @map("due_date")
  rushFee        Int             @default(0) @map("rush_fee") // cents
  discount       Float           @default(0) // percentage
  discountAmount Int             @default(0) @map("discount_amount") // fixed in cents
  taxRate        Float           @default(0) @map("tax_rate")
  subtotal       Int             @default(0) // cents
  taxAmount      Int             @default(0) @map("tax_amount") // cents
  total          Int             @default(0) // cents
  notes          String?
  internalNotes  String?         @map("internal_notes")
  lineItems      QuoteLineItem[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@map("quotes")
}

model QuoteLineItem {
  id              String              @id @default(cuid())
  quoteId         String              @map("quote_id")
  quote           Quote               @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  sortOrder       Int                 @default(0) @map("sort_order")
  garmentStyle    String?             @map("garment_style")
  garmentBrand    String?             @map("garment_brand")
  garmentName     String?             @map("garment_name")
  garmentColor    String?             @map("garment_color")
  garmentSKU      String?             @map("garment_sku")
  supplierCode    String?             @map("supplier_code")
  garmentUnitCost Int                 @default(0) @map("garment_unit_cost") // cents
  decorationType  String              @default("SCREEN_PRINT") @map("decoration_type")
  printLocations  Int                 @default(1) @map("print_locations")
  colorCount      Int                 @default(1) @map("color_count")
  stitchCount     Int?                @map("stitch_count")
  description     String?
  artworkUrl      String?             @map("artwork_url")
  decorationPrice Int                 @default(0) @map("decoration_price") // per piece cents
  setupFee        Int                 @default(0) @map("setup_fee") // cents
  markupPercent   Float               @default(0) @map("markup_percent")
  unitPrice       Int                 @default(0) @map("unit_price") // cents
  totalQuantity   Int                 @default(0) @map("total_quantity")
  lineTotal       Int                 @default(0) @map("line_total") // cents
  sizes           QuoteLineItemSize[]
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@map("quote_line_items")
}

model QuoteLineItemSize {
  id         String        @id @default(cuid())
  lineItemId String        @map("line_item_id")
  lineItem   QuoteLineItem @relation(fields: [lineItemId], references: [id], onDelete: Cascade)
  size       String
  quantity   Int           @default(0)

  @@unique([lineItemId, size])
  @@map("quote_line_item_sizes")
}

model GarmentProduct {
  id             String  @id @default(cuid())
  styleCode      String  @map("style_code")
  fullStyleCode  String? @map("full_style_code")
  brandName      String  @map("brand_name")
  productName    String  @map("product_name")
  description    String?
  weight         String?
  category       String?
  supplier       String  @default("alphabroder")
  wholesalePrice Int     @default(0) @map("wholesale_price") // cents
  imageUrl       String? @map("image_url")
  colors         String  @default("[]") // JSON array
  sizes          String  @default("[]") // JSON array
  active         Boolean @default(true)

  @@unique([styleCode, supplier])
  @@map("garment_products")
}

model PricingMatrix {
  id             String   @id @default(cuid())
  name           String
  decorationType String   @map("decoration_type")
  isDefault      Boolean  @default(false) @map("is_default")
  rules          String   @default("[]") // JSON array of pricing rules
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("pricing_matrices")
}

